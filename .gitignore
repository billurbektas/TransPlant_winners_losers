# Checksum-recorded generated history remains present in the in-repository
# archive but is not added to Git. Scientific source snapshots and archive
# manifests remain trackable.
archive/**/output/

# Interrupted atomic writes
*.tmp

# Local receipts used to distinguish regenerated figures from legacy files
*.pdf.generated
*.png.generated

# Legacy whole-session snapshots are not pipeline inputs
Environment_Save_*.RData
